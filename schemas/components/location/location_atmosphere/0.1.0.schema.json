{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:location:location_atmosphere:0.1.0",
  "title": "LocationAtmosphereComponent 0.1.0",
  "description": "保存 Location 的典型感官氛围与长期文化印象。",
  "allOf": [
    { "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0" },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "atmosphere_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "sensory_features": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "uniqueItems": true },
            "cultural_impressions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "uniqueItems": true }
          },
          "required": ["atmosphere_summary", "sensory_features", "cultural_impressions"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
