{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:core:history_index:0.1.0",
  "title": "HistoryIndexComponent 0.1.0",
  "description": "保存可从 Event 权威引用重建的历史检索入口。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": { "type": "boolean" },
        "data": {
          "type": "object",
          "properties": {
            "event_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "event_ref": {
                    "allOf": [
                      {
                        "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": { "const": "event" }
                        }
                      }
                    ]
                  },
                  "index_roles": {
                    "type": "array",
                    "items": {
                      "enum": ["recent", "important"]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": ["event_ref", "index_roles"],
                "additionalProperties": false
              }
            }
          },
          "required": ["event_refs"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}