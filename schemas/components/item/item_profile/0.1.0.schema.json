{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:item:item_profile:0.1.0",
  "title": "ItemProfileComponent 0.1.0",
  "description": "保存 Item 的类别、实例模式、功能、材料和稳定形态。",
  "allOf": [
    { "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0" },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "item_kind": { "type": "string", "minLength": 1, "maxLength": 120 },
            "instance_mode": { "enum": ["unique", "individual", "stack"] },
            "primary_functions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "uniqueItems": true },
            "materials": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true },
            "form_description": { "type": "string", "minLength": 1, "maxLength": 1500 }
          },
          "required": ["item_kind", "instance_mode", "primary_functions", "materials", "form_description"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
