{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:event:event_participant_reference:0.1.0",
  "title": "EventParticipantReferenceComponent 0.1.0",
  "description": "保存实际参与、观察或接收当前 Event 的 Character 权威引用。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "participant_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "participant_ref": {
                    "allOf": [
                      {
                        "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": { "const": "character" }
                        }
                      }
                    ]
                  },
                  "participation_roles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "description": "该 Character 在本 Event 中实际承担的角色；第一版不提前封闭角色枚举。"
                  }
                },
                "required": ["participant_ref", "participation_roles"],
                "additionalProperties": false
              },
              "description": "同一 Character 只出现一次，全部参与角色集中在同一项。"
            }
          },
          "required": ["participant_refs"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
