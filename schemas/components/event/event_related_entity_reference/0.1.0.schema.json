{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:event:event_related_entity_reference:0.1.0",
  "title": "EventRelatedEntityReferenceComponent 0.1.0",
  "description": "保存与当前 Event 事实有关的 World Entity 引用，不推断其是否实际参与。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "related_entity_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "allOf": [
                  {
                    "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": ["character", "location", "item", "organization", "skill", "concept", "character_relation"]
                      }
                    }
                  }
                ]
              },
              "description": "同一目标 Entity 只出现一次；该引用只表示 Event 中存在与它有关的可召回事实。"
            }
          },
          "required": ["related_entity_refs"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
