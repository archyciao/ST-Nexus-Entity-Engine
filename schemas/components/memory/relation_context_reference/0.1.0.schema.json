{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:memory:relation_context_reference:0.1.0",
  "title": "RelationContextReferenceComponent 0.1.0",
  "description": "保存 Memory 对相关 Relation 及具体关系面向的权威直接引用。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "relation_links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relation_ref": {
                    "allOf": [
                      {
                        "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": { "const": "character_relation" }
                        }
                      }
                    ]
                  },
                  "related_aspect_ids": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^relation_aspect_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "description": "该 Memory 直接涉及的目标 Relation Aspect。"
                  },
                  "context_roles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "formation_basis",
                        "turning_point",
                        "current_basis",
                        "important"
                      ]
                    },
                    "description": "该 Memory 对目标关系承担的语义作用。"
                  }
                },
                "required": [
                  "relation_ref",
                  "related_aspect_ids",
                  "context_roles"
                ],
                "additionalProperties": false
              },
              "description": "同一 Relation 的 Aspect 和语义角色集中在同一项。"
            }
          },
          "required": ["relation_links"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
