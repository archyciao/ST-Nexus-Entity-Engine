{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:memory:memory_owner_reference:0.1.0",
  "title": "MemoryOwnerReferenceComponent 0.1.0",
  "description": "保存拥有当前主观认知的唯一 Character 权威引用。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "owner_ref": {
              "allOf": [
                {
                  "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "const": "character" }
                  }
                }
              ]
            }
          },
          "required": ["owner_ref"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
