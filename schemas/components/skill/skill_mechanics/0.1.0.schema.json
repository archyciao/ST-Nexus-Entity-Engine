{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:skill:skill_mechanics:0.1.0",
  "title": "SkillMechanicsComponent 0.1.0",
  "description": "用可定位自然语言条目保存 Skill 的核心运作机制。",
  "allOf": [
    { "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0" },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "mechanics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "skill_mechanic_id": { "type": "string", "pattern": "^skill_mechanic_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
                  "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "description": { "type": "string", "minLength": 1, "maxLength": 1500 }
                },
                "required": ["skill_mechanic_id", "kind", "description"],
                "additionalProperties": false
              }
            }
          },
          "required": ["mechanics"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
