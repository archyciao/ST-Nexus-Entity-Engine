{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:character:relation_index:0.1.0",
  "title": "RelationIndexComponent 0.1.0",
  "description": "保存可从 Character Relation Endpoint 重建的关系检索入口。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": { "type": "boolean" },
        "data": {
          "type": "object",
          "properties": {
            "relation_refs": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": { "const": "character_relation" }
                    }
                  }
                ]
              },
              "uniqueItems": true,
              "description": "相关 Character Relation 的可重建引用。"
            }
          },
          "required": ["relation_refs"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
