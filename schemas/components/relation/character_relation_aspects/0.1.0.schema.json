{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:relation:character_relation_aspects:0.1.0",
  "title": "CharacterRelationAspectsComponent 0.1.0",
  "description": "在同一 Character Relation 中集中保存师徒、亲属、合作、敌意等关系面向。",
  "allOf": [
    {
      "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "aspects": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "aspect_id": {
                    "type": "string",
                    "pattern": "^relation_aspect_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                    "description": "系统生成的关系面向局部稳定标识。"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "可扩展的登记类别，例如 master_disciple 或 personal_distrust。"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "该面向当前事实和含义的自然语言说明。"
                  },
                  "status": {
                    "enum": ["active", "ended"],
                    "description": "该面向当前是否仍然有效；结束不会删除历史。"
                  },
                  "perspective": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "enum": ["shared_fact", "character_view"],
                        "description": "shared_fact 表示共同事实；character_view 表示某个 Character 的单方认知。"
                      },
                      "owner_ref": {
                        "allOf": [
                          {
                            "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": { "const": "character" }
                            }
                          }
                        ],
                        "description": "持有单方认知的 Character；必须是当前 Relation 的一个端点。"
                      }
                    },
                    "required": ["mode"],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "mode": { "const": "character_view" }
                          }
                        },
                        "then": {
                          "required": ["owner_ref"]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "mode": { "const": "shared_fact" }
                          }
                        },
                        "then": {
                          "not": {
                            "required": ["owner_ref"]
                          }
                        }
                      }
                    ],
                    "additionalProperties": false,
                    "description": "区分共同事实与单方认知；这里的指向性不是师父、徒弟等参与角色方向。"
                  },
                  "participant_roles": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "properties": {
                        "character_ref": {
                          "allOf": [
                            {
                              "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": { "const": "character" }
                              }
                            }
                          ]
                        },
                        "roles": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 8,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "description": "该 Character 在当前关系面向中的角色。"
                        }
                      },
                      "required": ["character_ref", "roles"],
                      "additionalProperties": false
                    }
                  },
                  "disclosure": {
                    "type": "object",
                    "properties": {
                      "visibility": {
                        "enum": ["public", "private", "secret"],
                        "description": "该关系面向在世界中的客观披露状态。"
                      },
                      "concealed_from_refs": {
                        "type": "array",
                        "maxItems": 2,
                        "uniqueItems": true,
                        "items": {
                          "allOf": [
                            {
                              "$ref": "urn:world-simulator:schema:core:entity-reference:0.1.0"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": { "const": "character" }
                              }
                            }
                          ]
                        },
                        "description": "主动隐瞒的目标；实际是否知情仍以 Memory 为准。"
                      }
                    },
                    "required": ["visibility"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "aspect_id",
                  "kind",
                  "description",
                  "status",
                  "perspective",
                  "participant_roles",
                  "disclosure"
                ],
                "additionalProperties": false
              },
              "description": "同一对 Character 的全部关系面向；允许为空。"
            }
          },
          "required": ["aspects"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
