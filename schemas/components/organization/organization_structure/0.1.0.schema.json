{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:organization:organization_structure:0.1.0",
  "title": "OrganizationStructureComponent 0.1.0",
  "description": "保存 Organization 的治理方式和职位定义，不保存实际任职者副本。",
  "allOf": [
    { "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0" },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "governance_model": { "type": "string", "minLength": 1, "maxLength": 1500 },
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "organization_role_id": { "type": "string", "pattern": "^organization_role_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
                  "role_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
                },
                "required": ["organization_role_id", "role_key", "name", "description"],
                "additionalProperties": false
              }
            }
          },
          "required": ["governance_model", "roles"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
