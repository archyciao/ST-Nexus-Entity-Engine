{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:component:organization:organization_strategy:0.1.0",
  "title": "OrganizationStrategyComponent 0.1.0",
  "description": "保存 Organization 的长期方向与决策原则，不保存推进过程。",
  "allOf": [
    { "$ref": "urn:world-simulator:schema:core:component-envelope:0.1.0" },
    {
      "type": "object",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "enabled": false,
        "data": {
          "type": "object",
          "properties": {
            "long_term_directions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "organization_direction_id": { "type": "string", "pattern": "^organization_direction_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
                  "description": { "type": "string", "minLength": 1, "maxLength": 1200 }
                },
                "required": ["organization_direction_id", "description"],
                "additionalProperties": false
              }
            },
            "decision_style": { "type": "string", "minLength": 1, "maxLength": 1200 }
          },
          "required": ["long_term_directions", "decision_style"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
