{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-simulator:schema:core:entity-reference:0.1.0",
  "title": "EntityReference",
  "description": "持久化 Entity 引用，只保存稳定 ID 和预期 Type。",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:world-simulator:schema:core:entity-id:0.1.0",
      "description": "目标 Entity 的系统生成稳定 ID；禁止由 AI 编写或模糊改写。"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
      "description": "目标 Entity 的预期 Type，必须与 ID 前缀一致；禁止模糊改写。"
    }
  },
  "required": ["id", "type"],
  "additionalProperties": false
}
